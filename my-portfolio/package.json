{
  "name": "my-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content:export": "node scripts/export-sheets.mjs",
    "content:import": "node scripts/import-content.mjs",
    "content:verify-import": "node scripts/verify-import.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "assets:collect": "node scripts/collect-assets.mjs",
    "prepare:site": "npm run content:validate && node scripts/prepare-site.mjs",
    "dev": "npm run prepare:site && react-router dev",
    "build": "npm run prepare:site && react-router build && node scripts/finalize-build.mjs",
    "lint": "eslint .",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.554.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^7.18.4",
    "@react-router/node": "^7.18.4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2"
  }
